<odoo>
    <record id="stock_reason_code_form" model="ir.ui.view">
        <field name="name">stock.reason.code.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='origin_grp']" position='after'>
                <group string="Reason Code" invisible="not is_scrap">
                    <field name="reason_code_id" />
                </group>
            </xpath>
        </field>
    </record>
    <record id="stock_scrap_move_form_reason_code" model="ir.ui.view">
        <field name="name">stock.scrap.move.form.reason.code</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/group" position='inside'>
                <field name="reason_code_id" readonly="state == 'done'" />
            </xpath>
            <field name="scrap_reason_tag_ids" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <field name="location_dest_id" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="force_save">1</attribute>
            </field>
        </field>
    </record>
    <record id="stock_scrap_move_list_reason_code" model="ir.ui.view">
        <field name="name">stock.scrap.move.list.reason.code</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position='after'>
                <field name="reason_code_id" readonly="state == 'done'" />
            </xpath>
        </field>
    </record>
</odoo>
